{
  "version": 1,
  "meta": {
    "title_min": 50,
    "title_max": 100,
    "desc_min": 170,
    "desc_max": 250
  },
  "canonical": {
    "ignore_query_params": ["PAGEN_1", "PAGEN_2", "PAGEN", "page", "PAGEN_3", "PAGEN_4"],
    "strip_trailing_slash": true,
    "duplicate_requires_no_self_canonical": true
  },
  "robots": {
    "required_directive": "Disallow: /*?"
  },
  "jsonld": {
    "allowed_jsonld_types": ["Article", "NewsArticle", "BlogPosting", "Movie", "Review", "Recipe", "QAPage"],
    "required_content_fields": ["@id", "headline", "text"]
  },
  "geo_aeo": {
    "ai_crawlers": ["GPTBot", "Google-Extended", "ClaudeBot", "PerplexityBot", "anthropic-ai", "cohere-ai", "AI2", "facebookexternalhit", "twitterbot"],
    "required_jsonld_types": ["Article", "NewsArticle", "BlogPosting", "Organization", "LocalBusiness", "BreadcrumbList", "FAQPage", "Product"],
    "required_opengraph": ["og:title", "og:description", "og:image", "og:url", "og:type"],
    "required_https": true,
    "required_llms_txt": true,
    "max_url_depth": 4
  }
}
